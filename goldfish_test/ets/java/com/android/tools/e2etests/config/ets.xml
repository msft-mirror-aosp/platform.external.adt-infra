<!-- Emulator test suite configuration. -->
<configuration description="A basic Tradefed test configuration">

  <test class="com.android.tools.testlib.tradefed.EmulatorTestSuite">
    <option name="tests-dir" value="testcases" />
    <option name="skip-loading-config-jar" value="true" />
  </test>

  <result_reporter class="com.android.tradefed.result.ConsoleResultReporter" />
  <result_reporter class="com.android.tools.testlib.tradefed.XtsXmlFormattedGeneratorReporter">
    <option name="results-dir" value="results" />
  </result_reporter>

  <log_saver class="com.android.tools.testlib.tradefed.XtsFileSystemLogSaver">
    <option name="logs-dir" value="logs" />
  </log_saver>

</configuration>
