load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")
load("//ets:ets.bzl", "ets_host_test", "ets_pkg")

ets_pkg(
    name = "pkg",
    srcs = [
        ":ScreenshotTest.apk",
        ":ScreenshotTest.config",
        ":adb_screen_cap_test_config",
    ],
)

ets_host_test(
    name = "adb_screen_cap_test",
    srcs = ["AdbScreenCapTest.kt"],
    class_name = "com.android.tools.e2etests.display.AdbScreenCapTest",
    description = "Host test checking adb screencap",
    deps = [
        "@tradefed//:tradefed_jars",
    ],
)

kt_android_library(
    name = "screenshot_test_lib",
    testonly = 1,
    srcs = ["ScreenshotTest.kt"],
    deps = [
        "//deps/proto:aemu_java_grpc_lite",
        "//ets/java/com/android/tools/e2etests/animatebox:animate_box",
        "//ets/java/com/android/tools/e2etests/grpc:grpc_lib",
        "@maven//:androidx_test_core",
        "@maven//:androidx_test_runner",
        "@maven//:androidx_test_services_storage",
        "@maven//:androidx_test_uiautomator_uiautomator",
        "@maven//:com_google_testparameterinjector_test_parameter_injector",
        "@tradefed//:tradefed_jars",
    ],
)

android_binary(
    name = "ScreenshotTest",
    testonly = 1,
    custom_package = "com.android.tools.e2etests.display",
    manifest = "ScreenshotTestManifest.xml",
    manifest_values = {
        "minSdkVersion": "36",
        "targetSdkVersion": "36",
    },
    deps = [":screenshot_test_lib"],
)
