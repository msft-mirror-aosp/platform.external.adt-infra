load("//ets:ets.bzl", "ets_device_test", "ets_pkg")

ets_pkg(
    name = "pkg",
    srcs = [
        ":ClipboardTest.apk",
        ":ClipboardTest_config",
    ],
)

ets_device_test(
    name = "ClipboardTest",
    srcs = ["ClipboardTest.kt"],
    description = "Tests related to the clipboard",
    manifest_app_extra = """
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    """,
    manifest_extra = """
    <uses-permission android:name="android.permission.READ_CLIPBOARD_IN_BACKGROUND" />
    """,
    package = "com.android.tools.e2etests.clipboard",
    deps = [
        "//deps/proto:aemu_java_grpc_lite",
        "//ets/java/com/android/tools/e2etests/grpc:grpc_lib",
        "//testlib/java/com/android/tools/testlib/emu:eventually",
        "@maven//:androidx_test_core",
        "@maven//:androidx_test_ext_junit",
        "@maven//:androidx_test_runner",
        "@maven//:com_google_testparameterinjector_test_parameter_injector",
        "@tradefed//:tradefed_jars",
    ],
)