load("@rules_android//rules:rules.bzl", "android_binary")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

filegroup(
    name = "pkg",
    testonly = 1,
    srcs = [
        ":SensorTest.apk",
        ":SensorTest.config",
    ],
    visibility = ["//ets:__pkg__"],
)

kt_android_library(
    name = "sensor_test_lib",
    testonly = 1,
    srcs = ["SensorTest.kt"],
    deps = [
        "//deps/proto:aemu_java_grpc_lite",
        "//ets/java/com/android/tools/e2etests/grpc:grpc_lib",
        "@maven//:androidx_test_core",
        "@maven//:androidx_test_runner",
        "@maven//:com_google_testparameterinjector_test_parameter_injector",
    ],
)

android_binary(
    name = "SensorTest",
    testonly = 1,
    custom_package = "com.android.tools.e2etests.sensors",
    manifest = "SensorTestManifest.xml",
    manifest_values = {
        "minSdkVersion": "36",
        "targetSdkVersion": "36",
    },
    deps = [":sensor_test_lib"],
)
