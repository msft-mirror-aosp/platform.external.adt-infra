load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load(":ets.bzl", "ets_plan")

pkg_files(
    name = "e2e_host_tests",
    testonly = True,
    srcs = [
        "//ets/java/com/android/tools/e2etests:e2e_tests_post_deploy.jar",
        "//ets/java/com/android/tools/e2etests:e2e_tests_pre_deploy.jar",
        "@protobuf//:protobuf_java",
        "@protobuf//:protobuf_javalite",
        "@protobuf//java/lite:lite_nowkt",
    ],
    prefix = "android-ets/tools",
    renames = {
        "@protobuf//:protobuf_java": "protobuf_java.jar",
        "@protobuf//:protobuf_javalite": "protobuf_javalite.jar",
        "@protobuf//java/lite:lite_nowkt": "protobuf_javalite_runtime.jar",
    },
)

pkg_files(
    name = "ets_modules",
    testonly = True,
    srcs = [
        "//ets/java/com/android/tools/e2etests/avd:pkg",
        "//ets/java/com/android/tools/e2etests/battery:pkg",
        "//ets/java/com/android/tools/e2etests/boot:pkg",
        "//ets/java/com/android/tools/e2etests/call:pkg",
        "//ets/java/com/android/tools/e2etests/discovery:pkg",
        "//ets/java/com/android/tools/e2etests/display:pkg",
        "//ets/java/com/android/tools/e2etests/events:pkg",
        "//ets/java/com/android/tools/e2etests/files:pkg",
        "//ets/java/com/android/tools/e2etests/input:pkg",
        "//ets/java/com/android/tools/e2etests/netsim:pkg",
        "//ets/java/com/android/tools/e2etests/sensors:pkg",
        "//ets/java/com/android/tools/e2etests/sms:pkg",
        "//ets/java/com/android/tools/e2etests/snapshot:pkg",
        "//ets/java/com/android/tools/e2etests/telnet:pkg",
        "//ets/java/com/android/tools/e2etests/vulkan:pkg",
        "//ets/java/com/android/tools/e2etests/wifi:pkg",
        "@animation_app//file",
    ],
    # Bazel builds the apks in with read-only permissions, which tradefed does
    # not handle.
    attributes = pkg_attributes(mode = "0644"),
    prefix = "android-ets/testcases",
)

pkg_files(
    name = "ets_tradefed",
    testonly = True,
    srcs = [
        "ets-tradefed",
        "ets-tradefed.bat",
        "script_help.sh",
    ],
    attributes = pkg_attributes(mode = "0777"),
    prefix = "android-ets/tools",
)

pkg_filegroup(
    name = "android_ets",
    testonly = True,
    srcs = [
        ":e2e_host_tests",
        ":ets_modules",
        ":ets_tradefed",
        "@tradefed//:android_ets",
    ],
)

pkg_zip(
    name = "android_ets_zip",
    testonly = True,
    srcs = [
        ":android_ets",
    ],
    out = "android-ets.zip",
    visibility = ["//visibility:public"],
)

# Runs all of ets.
ets_plan(
    name = "ets",
    plan = "ets",
)

# Runs the presubmit ETS plan.
ets_plan(
    name = "presubmit",
    plan = "presubmit",
)

# Runs the presubmit ETS plan in exclusive mode for less contention.
ets_plan(
    name = "exclusive_presubmit",
    plan = "presubmit",
    tags = ["exclusive"],
)

# Currently there are no tests specific for the postsubmit. This alias exists so
# the build can run two different targets based on the environment, as they are
# expected to deviate in the future.
test_suite(
    name = "postsubmit",
    tests = [
        ":presubmit",
    ],
)

test_suite(
    name = "exclusive_postsubmit",
    tests = [
        ":exclusive_presubmit",
    ],
)
