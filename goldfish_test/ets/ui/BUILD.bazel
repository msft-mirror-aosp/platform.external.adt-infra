load("@rules_python//python:defs.bzl", "py_test")
load("//ets:ets.bzl", "ets_host_test", "ets_pkg", "ets_plan")

ets_pkg(
    name = "pkg",
    srcs = [
        ":device_hub_ui_test_config",
        ":snapshot_ui_test_config",
    ],
)

ets_host_test(
    name = "device_hub_ui_test",
    srcs = ["DeviceHubUiTest.kt"],
    class_name = "com.android.tools.e2etests.ui.DeviceHubUiTest",
    description = "Host test driving the Android Device Hub UI against the running emulator",
    deps = [
        "//testlib/java/com/android/tools/testlib/emu:discovery",
        "@tradefed//:tradefed_jars",
    ],
)

ets_host_test(
    name = "snapshot_ui_test",
    srcs = ["SnapshotUiTest.kt"],
    class_name = "com.android.tools.e2etests.ui.SnapshotUiTest",
    description = "Host test using uiautomator dump to locate Settings items and touching them via the Android Device Hub UI across cold boot and 3 snapshot save/load cycles",
    deps = [
        ":device_hub_ui_test",
        "//deps/proto:aemu_java_grpc",
        "//deps/proto:aemu_java_proto",
        "//ets/java/com/android/tools/e2etests/grpc:host_grpc_lib",
        "//testlib/java/com/android/tools/testlib/emu:discovery",
        "@tradefed//:tradefed_jars",
    ],
)

_UI_ARGS = [
    "--device_hub_dir",
    "$(rlocationpath @goldfish//emulator/launcher:android-device-hub)",
    "--display_dir",
    "$(rlocationpath @local//tools/emulator/testlib/display:ffmpeg_files)",
    "--skip_snapshot_relaunch",
]

_UI_DATA = [
    "@goldfish//emulator/launcher:android-device-hub",
    "@local//tools/emulator/testlib/display:ffmpeg_files",
] + select({
    "@platforms//os:linux": [
        "@local//tools/emulator/testlib/display:xvfb",
    ],
    "//conditions:default": [],
})

ets_plan(
    name = "ui",
    args = _UI_ARGS + [
        "--tradefed_args=--include-filter,DeviceHubUiTest,--include-filter,SnapshotUiTest",
    ],
    data = _UI_DATA,
    plan = "ets",
)

ets_plan(
    name = "snapshot_ui",
    args = _UI_ARGS + [
        "--tradefed_args=-m,SnapshotUiTest",
    ],
    data = _UI_DATA,
    plan = "ets",
)

# The system image :ui boots on gLinux. run_local.bat builds this to fetch it on Windows.
alias(
    name = "system_image",
    actual = "@android16k-x86_64//:all_files",
    tags = ["manual"],
)

# Reports the Tradefed results and outputs of a run_local.bat or run_external.bat run to Bazel, and
# with --config=sponge to Sponge, the way the Bazel tests do on gLinux and macOS. Run by
# report_to_sponge.bat; see report_results.py.
py_test(
    name = "report_results",
    size = "small",
    srcs = ["report_results.py"],
    tags = [
        "local",
        "manual",
    ],
)
