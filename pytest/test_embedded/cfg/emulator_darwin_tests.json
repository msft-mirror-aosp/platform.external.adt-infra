{
    "landscape_test_suite": {
        "description": "Set of tests that verify that graphic related tests work well in a `landscape` emulator",
        "launch_flags": [
            "-no-snapshot"
        ],
        "pytest_flags": [
            "-m graphics and not multidisplay",
            "--timeout=600"
        ],
        "avd_config": {
            "api": "33",
            "tag.id": "google_apis",
            "hw.initialOrientation": "landscape",
            "skin.name": "1280x720"
        },
        "status": "enabled"
    },
    "portrait_test_suite": {
