  "category": {
     "CTS": {
       "name": "CTS",
       "id": "",
       "scheduler": "cts_scheduler",
     },
     "emu-master-dev": {
       "name": "emu-master-dev",
       "id": "_1",
       "scheduler": "emu_master_dev_scheduler",
     },
     "emu-2.2-release": {
       "name": "Emulator build on SDK images",
       "id": "_2",
       "scheduler": "emu_2.2_release_scheduler",
     },
     "system-image-builds": {
       "name": "SDK emulator on system image builds",
       "id": "_3",
       "scheduler": "system_image_scheduler",
     },
     "cross-builds": {
