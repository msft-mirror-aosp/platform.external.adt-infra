  "schedulers": {
    "emu_master_dev_scheduler": {
      "project": ["emu-master-dev"],
      "type": "emu_scheduler",
    },
    "emu_2.2_release_scheduler": {
      "project": ["emu-2.2-release"],
      "type": "emu_scheduler",
    },
    "system_image_scheduler": {
      "project": ["klp-emu-dev", "lmp-mr1-emu-dev", "mnc-emu-dev", "nyc-emu-dev", "nyc-mr1-emu-dev", "lmp-emu-dev", "gb-emu-dev",
                  "ics-mr1-emu-dev", "jb-emu-dev", "jb-mr1.1-emu-dev", "jb-mr2-emu-dev"],
      "type": "emu_scheduler",
    },
    "sysimage_release_psq_scheduler": {
